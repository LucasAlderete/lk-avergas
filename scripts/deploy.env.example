# En la VPS: cp scripts/deploy.env.example deploy.env

WEB_ROOT=/var/www/avergas
GIT_BRANCH=main

PORT=3001
HOST=127.0.0.1

MONGODB_URI=mongodb://127.0.0.1:27017/avergas
MONGODB_DB=avergas

# OAuth Web client de Google Cloud. Orígenes autorizados:
#   https://avergas.lktools.com.ar
#   http://localhost:5173
GOOGLE_CLIENT_ID=

# Secreto largo y random para la cookie de sesión
SESSION_SECRET=cambia-esto-por-un-secreto-largo
