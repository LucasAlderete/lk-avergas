[Unit]
Description=Averga's Club API
After=network.target

[Service]
Type=simple
WorkingDirectory=__ROOT__
EnvironmentFile=-__ROOT__/deploy.env
Environment=NODE_ENV=production
Environment=TZ=America/Argentina/Buenos_Aires
ExecStart=__NODE__ server/index.js
Restart=on-failure
RestartSec=3
User=__USER__
Group=__GROUP__

[Install]
WantedBy=multi-user.target
